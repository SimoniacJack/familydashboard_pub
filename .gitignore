# Environment files
*.env
.env.*
!.env.example

# Dependencies
node_modules/
**/node_modules/
.venv/

# Build outputs
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Misc
.cache/
coverage/

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfstate
infra/terraform.tfstate.*
infra/terraform.tfvars
infra/tfplan

# SSH keys — never commit
*.pem
*.key

# Scratch / reference images (not part of the app)
image.png
referenceimage.png
food images/
.kiro/
familymembers/*

# Per-family content — each instance has its own; never in the public repo.
# Real profiles/photos and seed data live only on the instance.
familymembers/*
!familymembers/example-*.md
!familymembers/README.md
backend/data/_migrated_json/*
frontend/test-results/
backend/test-results/
