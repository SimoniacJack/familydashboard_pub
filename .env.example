# Copy to .env (gitignored) and fill in your own values.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://familydash:change-me@localhost:5432/familydashboard
OPENAI_API_KEY=sk-your-openai-key
TODOIST_API_TOKEN=your-todoist-token
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
GOOGLE_CALENDAR_ID=you@example.com

# --- Basic auth (Caddy gates the whole app) ---
# Generate a hash:  caddy hash-password --plaintext 'your-password'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=$2a$14$replace-with-your-own-bcrypt-hash

# --- Frontend (Vite) ---
# Your Google Calendar public embed URL.
VITE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=you%40example.com&ctz=Europe%2FLondon
