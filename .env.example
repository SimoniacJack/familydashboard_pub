# Family Dashboard — environment configuration
#
# Copy this file to `git.env` (gitignored) for local dev, or set these as real
# environment variables in production. Nothing here is committed.

# ── Your instance ────────────────────────────────────────────────────────────
# The one string that makes the dashboard "yours" — shown in the UI and used to
# steer meal-plan prompts. e.g. "Parker", "Smith".
FAMILY_NAME=The Family

# ── Auth (single shared family login) ────────────────────────────────────────
# A signing key for the session cookie. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# The login password, hashed and base64-wrapped (so docker env_file keeps the
# '$' delimiters intact). Generate with:
#   python -c "import base64; from werkzeug.security import generate_password_hash as g; print(base64.b64encode(g('YOUR_PASSWORD'.encode()).encode()).decode())"
AUTH_PASSWORD_HASH_B64=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. Falls back to a local dev default if unset.
DATABASE_URL=postgresql+psycopg://familydash:familydash@localhost:5432/familydashboard

# ── Integrations ─────────────────────────────────────────────────────────────
# OpenAI — meal plan generation (GPT-4o) + ingredient matching.
OPENAI_API_KEY=

# Google Calendar — read-only event overlay on the calendar. Optional; the app
# works without it (no events shown).
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ID=

# Todoist — the shopping list lives in a Todoist project. Optional; shopping
# features are disabled without a token.
TODOIST_API_TOKEN=
